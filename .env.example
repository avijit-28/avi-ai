# ==========================================
# Avi AI Environment Configuration
# ==========================================

# Cloud LLM API Keys (Keep secret, never commit)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Backend Configuration (Optional FastAPI)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_AUTH_SECRET=

# Telephony Defaults
DEFAULT_ANSWER_DELAY_SECONDS=15
DEFAULT_LANGUAGE=en-IN
ENABLE_RECORDING_BY_DEFAULT=true
ENABLE_CALLER_MEMORY=false
